{
  "name": "patchwork-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && tsx --test --test-concurrency=1 tests/*.test.ts",
    "lint": "eslint . --ignore-pattern '**/dist/**' --ignore-pattern .next",
    "contrast": "node tools/contrast.mjs",
    "assets:generate": "node tools/assets/generate.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "lighthouse": "node tools/lighthouse.mjs",
    "playwright": "node tools/playwright-full.mjs",
    "demo": "node tools/demo-supervisor.mjs",
    "demo:video": "node tools/demo-video.mjs",
    "demo:reset": "node tools/demo-reset.mjs",
    "loc": "node tools/loc.mjs",
    "judge": "node tools/judge.mjs",
    "performance": "node tools/performance-evidence.mjs",
    "core:gate": "node tools/core-gate.mjs",
    "sdk:size": "node tools/sdk-size.mjs",
    "extension:build": "node tools/extension-build.mjs",
    "extension:smoke": "npm run extension:build && node tools/extension-smoke.mjs",
    "verifier:smoke": "npm run --workspace @patchwork/verifier smoke",
    "verifier:evidence": "tsx tools/verifier-evidence.ts",
    "ai:smoke": "npm run --workspace @patchwork/ai smoke",
    "ai:evidence": "tsx tools/ai-evidence.ts",
    "ai:eval": "tsx tools/ai-evidence.ts",
    "api:smoke": "npm run --workspace @patchwork/api smoke",
    "api:start": "npm run --workspace @patchwork/api start",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.3.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
